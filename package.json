{
  "name": "puttszisms",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute puttszisms-db --file=schema.sql",
    "db:migrate:local": "wrangler d1 execute puttszisms-db --local --file=schema.sql",
    "typecheck": "bunx tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "check": "tsc --noEmit && biome check src/",
    "postinstall": "command -v bun2nix >/dev/null && bun2nix -o bun.nix || true"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0"
  }
}
